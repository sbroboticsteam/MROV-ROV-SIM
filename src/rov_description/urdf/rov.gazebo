        filename="plugins/libEER_Servo.so"
        name="gz::sim::systems::Servo">
          <joint>BevelLeft</joint>
          <topic>bevelleft</topic>
  </plugin>
</gazebo>

<gazebo> 
  <plugin
        filename="plugins/libEER_Servo.so"
        name="gz::sim::systems::Servo">
