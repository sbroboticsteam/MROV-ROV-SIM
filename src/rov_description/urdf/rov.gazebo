<?xml version="1.0" ?>
<robot name="rov" xmlns:xacro="http://www.ros.org/wiki/xacro" >

<gazebo>
  <!-- Joint State Publisher -->
  <plugin filename="gz-sim-joint-state-publisher-system" 
          name="gz::sim::systems::JointStatePublisher">
    <topic>rov/joint_states</topic>
    <update_rate>50</update_rate>
  </plugin>
</gazebo>

<gazebo>
  <!-- Odometry Publisher -->
  <plugin filename="gz-sim-odometry-publisher-system" 
          name="gz::sim::systems::OdometryPublisher">
    <odom_frame>odom</odom_frame>
    <robot_base_frame>base_link</robot_base_frame>
    <odom_publish_frequency>50</odom_publish_frequency>
    <odom_topic>rov/odom</odom_topic>
    <dimensions>3</dimensions>
  </plugin>
</gazebo>

<!-- Import for Camera plugins -->
<plugin
  filename="gz-sim-sensors-system"
  name="gz::sim::systems::Sensors">
  <render_engine>ogre2</render_engine>
</plugin>

<!-- Buoyancy Plugin-->
<gazebo>
  <plugin
      filename="plugins/libEER_Buoyancy.so"
      name="gz::sim::systems::EER_Buoyancy">
      <uniform_fluid_density>1000</uniform_fluid_density>
      <set_volume>
          <entity>base_link</entity>
          <!-- Displaes approximately 18.48kg of water (extra volume displaced can be imagined as adding foam) -->
          <volume>0.013</volume>
          <center_of_volume>0 0 0</center_of_volume>
      </set_volume>
      <enable>base_link</enable>
  </plugin>
</gazebo>

<!--HydroDynamics plugin-->
<gazebo>
  <plugin
          filename="plugins/libEER_Hydrodynamics.so"
          name="gz::sim::systems::EER_Hydrodynamics">
          <link_name>base_link</link_name>
          <water_density>1000</water_density>
          <xDotU>1.26231244</xDotU>
          <yDotV>1.22524088</yDotV>
          <zDotW>10</zDotW> <!--Should be 27.12577546 but that makes it crash-->
          <kDotP>0.08757268</kDotP>
          <mDotQ>0.05547139</mDotQ>
          <nDotR>0.07264728</nDotR>
          <xUabsU>-150</xUabsU>
          <xU>-30</xU>
          <yVabsV>-200</yVabsV>
          <yV>-25</yV>
          <zWabsW>-425</zWabsW>
          <zW>-300</zW>
          <kPabsP>-150</kPabsP>
          <kP>-100</kP>
          <mQabsQ>-125</mQabsQ>
          <mQ>-50</mQ>
          <nRabsR>-100</nRabsR>
          <nR>-45</nR>
  </plugin>
</gazebo>

<!--Servo Plugins for each of the arm joint-->
<gazebo> 
  <plugin
        filename="plugins/libEER_Servo.so"
        name="gz::sim::systems::Servo">
          <joint>arm0</joint>
          <topic>arm0</topic>
  </plugin>
</gazebo>

<gazebo> 
  <plugin
        filename="plugins/libEER_Servo.so"
        name="gz::sim::systems::Servo">
          <joint>arm1</joint>
          <topic>arm1</topic>
  </plugin>
</gazebo>

<gazebo> 
  <plugin
        filename="plugins/libEER_Servo.so"
        name="gz::sim::systems::Servo">
          <joint>arm2</joint>
          <topic>arm2</topic>
  </plugin>
</gazebo>

<!-- NEW Encoder Topics -->
<gazebo>
  <plugin filename="plugins/libBRT27.so" name="gz::sim::systems::BRT27">
    <joint>arm0</joint>
    <joint_name>base</joint_name>
  </plugin>
</gazebo>

<gazebo>
  <plugin filename="plugins/libBRT27.so" name="gz::sim::systems::BRT27">
    <joint>arm1</joint>
    <joint_name>prox</joint_name>
  </plugin>
</gazebo>

<gazebo>
  <plugin filename="plugins/libBRT27.so" name="gz::sim::systems::BRT27">
    <joint>arm2</joint>
    <joint_name>dist</joint_name>
  </plugin>
</gazebo>

<!--Differential Claw System Joints -->
<gazebo> 
  <plugin
        filename="plugins/libEER_Servo.so"
        name="gz::sim::systems::Servo">
          <joint>BevelEnd</joint>
          <topic>bevelend</topic>
  </plugin>
</gazebo>

<gazebo> 
  <plugin
        filename="plugins/libEER_Servo.so"
        name="gz::sim::systems::Servo">
          <joint>BevelRight</joint>
          <topic>bevelright</topic>
