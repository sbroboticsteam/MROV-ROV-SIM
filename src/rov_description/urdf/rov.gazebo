<!-- USB Camera Sensors -->
<gazebo reference="CameraUSB_v1__1__1">
  
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <self_collide>true</self_collide>
  <sensor name="usb_cam_0" type="camera">
    <always_on>true</always_on>
    <update_rate>30</update_rate>
    <pose>0.0321945 -0.055127 -0.055127 0 0.88 -1.385398163</pose>
    <!-- Gazebo Transport topic -->
    <topic>rov/camera_usb_0/image_raw</topic>

    <camera name="usb_cam_0_camera">
      <camera_info_topic>rov/camera_usb_0/camera_info</camera_info_topic>

      <horizontal_fov>1.047</horizontal_fov> <!-- ~60 deg -->
      <image>
        <width>640</width>
        <height>480</height>
        <format>R8G8B8</format>
      </image>
      <clip>
        <near>0.05</near>
        <far>50</far>
      </clip>
      <visibility_mask>0x3fffffff</visibility_mask>
    </camera>
  </sensor>
</gazebo>

<gazebo reference="CameraUSB_v1_1">
  
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <self_collide>true</self_collide>
  <sensor name="usb_cam_1" type="camera">
    <always_on>true</always_on>
    <update_rate>30</update_rate>
    <pose>-0.015127 -0.015127 -0.0150127 0 0 -2.485398163</pose>
    <topic>rov/camera_usb_1/image_raw</topic>

    <camera name="usb_cam_1_camera">
      <camera_info_topic>rov/camera_usb_1/camera_info</camera_info_topic>

      <horizontal_fov>1.047</horizontal_fov>
      <image>
        <width>640</width>
        <height>480</height>
        <format>R8G8B8</format>
      </image>
      <clip>
        <near>0.05</near>
        <far>50</far>
      </clip>
      <visibility_mask>0x3fffffff</visibility_mask>
    </camera>
  </sensor>
</gazebo>

<!-- Insta360 Air approximation: two 210° wide-angle cameras (front/back) -->
<!-- Specs reference: dual 210° lenses, 2560x1280@30fps output in real device -->
<!-- In sim we model it as 2 fisheyes you can stitch in ROS if desired -->

<gazebo reference="insta360_backcam_link">
  <sensor name="insta360_back" type="wideanglecamera">
    <always_on>1</always_on>
    <visualize>true</visualize>
    <update_rate>30</update_rate>
    <!-- 90 degree rotation -->
    <pose>0 0 0 0 0 1.5707963265</pose>
    <!-- Base topic name in Gazebo Transport -->
    <topic>/rov/camera/insta360/back</topic>

    <camera>
      <!-- 210 deg -->
      <horizontal_fov>3.665191429</horizontal_fov>

      <!-- Per-lens image; common to use square for fisheye -->
      <image>
        <width>2560</width>
        <height>1280</height>
        <format>R8G8B8</format>
      </image>

      <clip>
        <near>0.1</near>
        <far>100</far>
      </clip>
      <visibility_mask>1073741821</visibility_mask> 

      <lens>
        <type>stereographic</type>
        <scale_to_hfov>true</scale_to_hfov>
        <cutoff_angle>1.832595714</cutoff_angle> <!-- 105 deg -->
        <env_texture_size>1024</env_texture_size>
      </lens>
    </camera>
  </sensor>
</gazebo>

<gazebo reference="insta360_frontcam_link">
  <sensor name="insta360_front" type="wideanglecamera">
    <always_on>1</always_on>
    <visualize>true</visualize>
    <update_rate>30</update_rate>
    <pose>0 0 0 0 0 1.5707963265</pose>
    <topic>/rov/camera/insta360/front</topic>

    <camera>
      <horizontal_fov>3.665191429</horizontal_fov>
      <image>
        <width>2560</width>
        <height>1280</height>
        <format>R8G8B8</format>
      </image>
      <clip>
        <near>0.1</near>
        <far>100</far>
      </clip>
      <visibility_mask>1073741821</visibility_mask> 
      <lens>
        <type>stereographic</type>
        <scale_to_hfov>true</scale_to_hfov>
        <cutoff_angle>1.832595714</cutoff_angle>
        <env_texture_size>1024</env_texture_size>
      </lens>
    </camera>
  </sensor>
</gazebo>

 <!-- Stereo Camera Plugin--> 
<!-- Left camera -->
<gazebo reference="zed_left_cam_link">
  <sensor name="zed_left" type="camera">
    <always_on>1</always_on>
    <update_rate>30</update_rate>
    <visualize>true</visualize>

    <!-- Gazebo Transport image topic -->
    <topic>/rov/zed/left/image_raw</topic>

    <!-- Frame id that ends up in messages -->
    <gz_frame_id>zed_left_optical_frame</gz_frame_id>

    <camera>
      <!-- Gazebo Transport camera_info topic -->
      <camera_info_topic>/rov/zed/left/camera_info</camera_info_topic>

      <horizontal_fov>1.2</horizontal_fov>
      <image>
        <width>1280</width>
        <height>720</height>
        <format>R8G8B8</format>
      </image>
      <clip>
        <near>0.05</near>
        <far>50</far>
      </clip>
    </camera>
  </sensor>
</gazebo>

<!-- Right camera -->
<gazebo reference="zed_right_cam_link">
  <sensor name="zed_right" type="camera">
    <always_on>1</always_on>
    <update_rate>30</update_rate>
    <visualize>true</visualize>
    <topic>/rov/zed/right/image_raw</topic>
    <gz_frame_id>zed_right_optical_frame</gz_frame_id>

    <camera>
      <camera_info_topic>/rov/zed/right/camera_info</camera_info_topic>
      <horizontal_fov>1.2</horizontal_fov>
      <image>
        <width>1280</width>
        <height>720</height>
        <format>R8G8B8</format>
      </image>
      <clip>
        <near>0.05</near>
        <far>50</far>
      </clip>
    </camera>
  </sensor>
</gazebo>




