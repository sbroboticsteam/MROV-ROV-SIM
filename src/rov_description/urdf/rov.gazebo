<?xml version="1.0" ?>
<robot name="rov" xmlns:xacro="http://www.ros.org/wiki/xacro" >

<xacro:property name="body_color" value="Gazebo/Silver" />

<!-- Buoyancy Plugin-->
<gazebo>
  <plugin
      filename="plugins/libEER_Buoyancy.so"
      name="gz::sim::systems::EER_Buoyancy">
      <uniform_fluid_density>1000</uniform_fluid_density>
      <set_volume>
          <entity>base_link</entity>
          <!-- Displaes approximately 18.48kg of water (extra volume displaced can be imagined as adding foam) -->
          <volume>0.01848</volume>
          <center_of_volume>0 0 0</center_of_volume>
      </set_volume>
      <enable>base_link</enable>
  </plugin>
</gazebo>

<!--HydroDynamics plugin-->
<gazebo>
  <plugin
          filename="plugins/libEER_Hydrodynamics.so"
          name="gz::sim::systems::EER_Hydrodynamics">
          <link_name>base_link</link_name>
          <water_density>1000</water_density>
          <xDotU>1.26231244</xDotU>
          <yDotV>1.22524088</yDotV>
          <zDotW>10</zDotW> <!--Should be 27.12577546 but that makes it crash-->
          <kDotP>0.08757268</kDotP>
          <mDotQ>0.05547139</mDotQ>
          <nDotR>0.07264728</nDotR>
          <xUabsU>-150</xUabsU>
          <xU>-30</xU>
          <yVabsV>-200</yVabsV>
          <yV>-25</yV>
          <zWabsW>-425</zWabsW>
          <zW>-300</zW>
          <kPabsP>-150</kPabsP>
          <kP>-100</kP>
          <mQabsQ>-125</mQabsQ>
          <mQ>-50</mQ>
          <nRabsR>-100</nRabsR>
          <nR>-45</nR>
  </plugin>
</gazebo>

<!--Servo Plugins-->
<gazebo> 
  <plugin
        filename="plugins/libEER_Servo.so"
        name="gz::sim::systems::Servo">
          <joint>shoulderjoint</joint>
          <topic>shoulderjoint</topic>
  </plugin>
</gazebo>

<gazebo> 
  <plugin
        filename="plugins/libEER_Servo.so"
        name="gz::sim::systems::Servo">
          <joint>elbowjoint</joint>
          <topic>elbowjoint</topic>
  </plugin>
</gazebo>

<gazebo> 
  <plugin
        filename="plugins/libEER_Servo.so"
        name="gz::sim::systems::Servo">
          <joint>wristjoint</joint>
          <topic>wristjoint</topic>
  </plugin>
</gazebo>

<!--Claw Plugin-->
<gazebo>
  <plugin
        filename="plugins/libEER_Claws.so"
        name="gz::sim::systems::Claws">
        <right_claw>
            <joint>rightclawjoint</joint>
            <max_inward_rotation>0.2094395</max_inward_rotation>
            <max_outward_rotation>0.523599</max_outward_rotation>
        </right_claw>
        <left_claw>
            <joint>leftclawjoint</joint>
            <max_inward_rotation>0.209439</max_inward_rotation>
            <max_outward_rotation>0.523599</max_outward_rotation>
        </left_claw>
    </plugin>
</gazebo>

<!--Thruster plugins to the proper joints-->
<gazebo>
    <plugin
        filename="plugins/libEER_Thruster.so"
        name="gz::sim::systems::EER_Thruster">
        <namespace>rov</namespace>
        <joint_name>backrightpropjoint</joint_name>
        <use_esc_cmd>true</use_esc_cmd>
        <thruster_input_voltage>18</thruster_input_voltage>
        <fluid_density>1000</fluid_density>
        <topic>backrightthrust</topic>
        <propeller_diameter>0.076</propeller_diameter>
    </plugin>
</gazebo>

