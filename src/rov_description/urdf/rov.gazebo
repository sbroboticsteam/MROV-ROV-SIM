        <joint_name>FrontRightThrust</joint_name>
        <use_esc_cmd>true</use_esc_cmd>
        <thruster_input_voltage>18</thruster_input_voltage>
        <fluid_density>1000</fluid_density>
        <topic>frt</topic>
        <propeller_diameter>0.076</propeller_diameter>
    </plugin>
</gazebo>

